"""
Quick Sort explanation:
This file implements the Quick Sort algorithm.
It chooses one element as a pivot, moves smaller values to the left and larger values
to the right, and then repeats the process on both sides.

This is a fast sorting method for many real-world cases because it usually works in
O(n log n) time, although it can become slower in some worst-case situations.
"""


def quick_sort(L, low, high):
    if low < high:
        # Choose the first element as the pivot.
        pivot = L[low]
        i = low + 1
        j = high

        while True:
            # Move i to the right while the values are smaller than or equal to the pivot.
            while (i <= j) and (L[i] <= pivot):
                i += 1

            # Move j to the left while the values are greater than or equal to the pivot.
            while (i <= j) and (L[j] >= pivot):
                j -= 1

            if i <= j:
                # Swap the two misplaced elements.
                L[i], L[j] = L[j], L[i]
            else:
                break

        # Place the pivot in its correct position.
        L[low], L[j] = L[j], L[low]

        # Recursively sort the left and right partitions.
        quick_sort(L, low, j - 1)
        quick_sort(L, j + 1, high)


Ar = [14, 23, 8, 5, 42, 7]
quick_sort(Ar, 0, len(Ar) - 1)
print(Ar)
